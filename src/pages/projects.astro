---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">My Projects</div>
  </div>

  <HorizontalCard
    title="ML Food Waste Management Software"
    img="/PantrySidekick.png"
    desc1 = "Collaborated in a team of 5 members to create an image detection software for detecting food items using Roboflow and Yolo v8."
    desc2 = "Built the backend using Python, implemented a structured SQLite database for inventory management, built the frontend using HTML, CSS, Javascript and connected the frontend and backend using Flask."
    desc3 = "Attained an accuracy of 80% for item recognition in real time using ML and built a REST API for data manipulation as well."
    desc4 = "Machine Learning, Roboflow, Yolo v8, Flask, Python, MySQL"
    url="/"
  />
  
  

  <div class="divider my-0"></div>
  <HorizontalCard
    title="3D Donkey Kong-Inspired Platformer"
    img="/DonkeyKong.png"
    desc1 = "Collaborated in a team of 4 to develop a modern 3D remake of the classic Donkey Kong arcade game using Unity."
    desc2 = "Implemented third-person character controls, power-ups (anti-gravity boots, size increase, fight-off, super jump), and scene transitions."
    desc3 = "Developed game mechanics such as ladder climbing, platforming, enemy spawning, and lock/key-based progression. Designed and scripted UI elements for score, health, main menu, and settings, and integrated sound effects, particle effects, and camera feedback for game interactions." 
    desc4 = "Unity, C#, Git, GitHub"
    url="#"
    
  />



  <div class="divider my-0"></div>
  <HorizontalCard
    title="Cognify: Smart Study Companion"
    img="/Cognify.png"
    desc1 = "Collaborated in a team to develop a web-based study app enabling card creation, deck organization, progress tracking, and study modes."
    desc2 = "Utilized Node.js, React, TypeScript, and MongoDB, integrating Docker for containerized deployment and CI/CD pipelines using GitHub Actions and Jest for automated testing."
    desc3 = "Implemented Factory, Iterator, and Singleton design patterns to enhance scalability and maintainability, while documenting the development process and deployment setup on GitHub." 
    desc4 = "Node.js, React, TypeScript, MongoDB, Docker, GitHub Actions"
    url="#"
    
  />

  

  <div class="divider my-0"></div>
  <HorizontalCard
    title="Grocery Deals Finder App"
    img="/Grocery.png"
    desc1 = "Collaborated in a team to develop an Android application enabling users to input shopping lists and retrieve the best deals from multiple stores using using Firebase Authentication and Firestore for real-time database management."
    desc2 = "Designed an intuitive interface focused on usability goals such as efficiency, ease of learning, and error prevention, ensuring a seamless user experience for diverse user profiles, including students and senior citizens."
    desc3 = "Integrated Firebase for notifications and implemented features for real-time deal comparison, item editing, and progress tracking, while documenting the development process for continuous improvement." 
    desc4 = "Android Studio, Java, Usability Engineering, Agile Development , Firebase, Firestore"
    url="#"
    
  />

<div class="divider my-0"></div>

<HorizontalCard
    title="Chatbot Software Development"
    img="/Chatbot.png"
    desc1 = "Collaborated in a team of 3 executives for the development of an AI Chatbot utilizing AIML, NLP, and Java."
    desc2 = "Maintained Version Control while connecting the Alice Bot Framework to work with various versions of AIML(XML) files."
    desc3 = "Successfully executed the steps in SDLC to document the development process on GitHub and created a guide."
    desc4 = "NLP, AIML, Java, Version Control, Chatbot Frameworks"
    url="#"
  />

<div class="divider my-0"></div>

  <HorizontalCard
    title="Chat Interface Project"
    img="/ChatInterface.png"
    desc1 = "Created a real-time messaging application with a Client-Server Architecture that allows users to send and receive messages in a secure and efficient manner."
    desc2 = "Implemented the chat functionality that enables the users to send and receive messages in real-time using Python's socket module."
    desc3 = "Integratd MySQL as the backend database to store user information, chat messages, and othe relevant data." 
    desc4 = "Python, SQL, Tkinter"
    url="#"
    
  />

  <div class="divider my-0"></div>


  
</BaseLayout>
