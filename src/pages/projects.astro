---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">My Projects</div>
  </div>

  <HorizontalCard
    title="TA Application & Management System (Capstone Project)"
    img="/project.png"
    desc1 = "Built a scalable full-stack platform that automated TA recruitment and scheduling, reducing manual coordination by ~60%."
    desc2 = "Designed role-based dashboards for students, instructors, admins, and coordinators, streamlining application reviews and allocations for 100+ users."
    desc3 = "Improved reliability by implementing 600+ automated tests with Pytest and React Testing Library, cutting potential regression issues by ~30%."
    desc4 = "Django, React, PostgreSQL, Docker, Pytest, React Testing Library"
    url="#"
  />

  <div class="divider my-0"></div>
  <HorizontalCard
    title="ML Food Waste Management Software"
    img="/PantrySidekick.png"
    desc1 = "Built a real-time image detection system using YOLOv8 and Roboflow to automate food inventory and reduce waste."
    desc2 = "Developed a full-stack app with Python, SQLite, and Flask, connecting to a web frontend built in HTML/CSS/JavaScript."
    desc3 = "Achieved 80% object recognition accuracy and created a REST API for efficient inventory data operations."
    desc4 = "Machine Learning, Roboflow, Yolo v8, Flask, Python, MySQL"
    url="/"
  />
  
  

  <div class="divider my-0"></div>
  <HorizontalCard
    title="3D Donkey Kong-Inspired Platformer"
    img="/DonkeyKong.png"
    desc1 = "Developed a 3D Unity platformer featuring smooth transitions, interactive levels, and retro-inspired gameplay."
    desc2 = "Built core mechanics including 3rd-person movement, enemy spawning, and power-ups like super jump and size boost."
    desc3 = "Designed game UI and integrated effects like sound, particles, and camera feedback for immersive play." 
    desc4 = "Unity, C#, Git, GitHub"
    url="#"
    
  />



  <div class="divider my-0"></div>
  <HorizontalCard
    title="Cognify: Smart Study Companion"
    img="/Cognify.png"
    desc1 = "Built a full-stack flashcard app with deck organization, progress tracking, and interactive study modes."
    desc2 = "Engineered using Node.js, React, TypeScript, MongoDB, and Docker; deployed via GitHub Actions CI/CD"
    desc3 = "Scaled to support 100,000+ flashcards through TDD with Jest and backend performance tuning." 
    desc4 = "Node.js, React, TypeScript, MongoDB, Docker, GitHub Actions"
    url="#"
    
  />

  

  <div class="divider my-0"></div>
  <HorizontalCard
    title="PricePal: Smart Grocery Saver"
    img="/PricePal.png"
    desc1 = "Built a Java-based Android app to compare grocery prices using user-generated shopping lists."
    desc2 = "Integrated Firebase Authentication and Firestore for secure, real-time data handling and syncing."
    desc3 = "Conducted usability testing across age groups, improving accessibility and reducing user error by 30%." 
    desc4 = "Android Studio, Java, Usability Engineering, Agile Development , Firebase, Firestore"
    url="#"
    
  />

<div class="divider my-0"></div>

<HorizontalCard
    title="Chatbot Software Development"
    img="/Chatbot.png"
    desc1 = "Collaborated in a team of 3 executives for the development of an AI Chatbot utilizing AIML, NLP, and Java."
    desc2 = "Maintained Version Control while connecting the Alice Bot Framework to work with various versions of AIML(XML) files."
    desc3 = "Successfully executed the steps in SDLC to document the development process on GitHub and created a guide."
    desc4 = "NLP, AIML, Java, Version Control, Chatbot Frameworks"
    url="#"
  />

<div class="divider my-0"></div>

  <HorizontalCard
    title="Chat Interface Project"
    img="/ChatInterface.png"
    desc1 = "Created a real-time messaging application with a Client-Server Architecture that allows users to send and receive messages in a secure and efficient manner."
    desc2 = "Implemented the chat functionality that enables the users to send and receive messages in real-time using Python's socket module."
    desc3 = "Integratd MySQL as the backend database to store user information, chat messages, and othe relevant data." 
    desc4 = "Python, SQL, Tkinter"
    url="#"
    
  />

  <div class="divider my-0"></div>


  
</BaseLayout>
