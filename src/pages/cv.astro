---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Objective</div>
  </div>

  <div class="mb-10 text-justify">
    As a Third-Year Computer Science major, I am eager to apply my technical skills, Knowledge, and Passion for Programming to
contribute to a challenging and dynamic environment
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Bachelor of Science Degree, Major in Computer Science"
      subtitle="University of British Columbia (UBC), Kelowna, BC, Canada (Expected Graduation - May, 2027) "
    />
    <TimeLineElement
      title="Secondary Education"
      subtitle="The Emerald Heights International School, Indore, India"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
  <TimeLineElement
      title="Game Developer - Beaver World"
      subtitle="Centre for Culture and Technology, UBC Okanagan (May 2025 - Current)"
    >
      <li style="text-indent: -20px; padding-left: 20px;">Developing mission systems, inventory management, and in-game notifications using Unity and C# to enhance gameplay
functionality in a 3D educational platform.</li>
    
    <li style="text-indent: -20px; padding-left: 20px;">Building scalable gameplay systems with modular scripts and managing collaborative development using Unity Version
Control, streamlining team workflows and feature integration.</li>
    
    <li class = 'mb-6' style="text-indent: -20px; padding-left: 20px;" >Designing user interfaces in Figma and conducting usability testing, reducing task completion time by 30% through HCI-
informed UI iterations.</li>
    </TimeLineElement>
    <TimeLineElement
      title="Subject Tutor"
      subtitle="UBC Okanagan Supplemental Learning Hub (September 2024 - April 2025)"
    >
      <li style="text-indent: -20px; padding-left: 20px;">Delivered 1-on-1 tutoring in Computer Science and Math using visual aids and analogies to clarify complex concepts.</li>
    
    <li style="text-indent: -20px; padding-left: 20px;">Tailored study plans to individual learning styles, resulting in a 15% average grade improvement.</li>
    
    <li class = 'mb-6' style="text-indent: -20px; padding-left: 20px;" >Tracked progress for 20+ students using session logs and feedback, adjusting teaching methods for better outcomes.</li>
    </TimeLineElement>
    
    
    
    <TimeLineElement
      title="Co-Founder and Vice President of Software"
      subtitle="Artificial Intelligence Club, UBC Okanagan (September 2023 – Present)"
    >
      <li style="text-indent: -20px; padding-left: 20px;">Co-founded and scaled UBCO’s AI Club to 200+ members through events, coding sessions, and outreach initiatives.</li>
      <li style="text-indent: -20px; padding-left: 20px;">Led development of an AI chatbot using Java, AIML, and NLP; hosted workshops on OOP design for student developers.</li>
      <li style="text-indent: -20px; padding-left: 20px;">Organized technical sessions with professors, boosting event attendance by 40% and enhancing peer learning.</li>
    </TimeLineElement>
    

  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li>
      <a href='https://www.udemy.com/share/103J8C3@Yal_JzNuHOOxJALF-5X8YxDsKsjzVMrPbC3J-5vwoDcYfY59fIVRS8OlyB9ShQdKVQ==/' target="_blank"> 100 Days of Code: The Complete Python Pro Bootcamp bu Angela Yu</a>
    </li>
    
    <li>
      <a href='https://www.udemy.com/share/101W923@zwFaYa73SksvOBS2OdQoztriZc1EwtTd8hJc3Upzvb2xZKsY49s2kkWZP3eXozPlLg==/' target="_blank"> Master the Coding Interviews: Data Structures and Algorithms by Andrei Neagoie</a>
